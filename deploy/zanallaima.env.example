# ZanaLLaima remoto: copiar a /home/<usuario>/.config/zanallaima/zanallaima.env (fuera del repo), chmod 600.
# Rutas absolutas siempre: systemd no expande ~.
# Solo nombres de variables. Los valores reales nunca se versionan ni se pegan en chats.

# Listener local (lo publica cloudflared)
ZANA_HTTP_PORT=8787
# Obligatorio: tu hostname público (el del túnel). No tiene valor por defecto.
ZANA_PUBLIC_HOST=
# ZANA_PUBLIC_MCP_URL=https://<tu-hostname>/mcp
ZANA_ALLOWED_ORIGINS=https://chatgpt.com
ZANA_OAUTH_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect

# Estado (rutas absolutas)
ZANA_STATE_FILE=/home/<usuario>/.local/share/zanallaima/state.json
ZANA_OAUTH_DB=/home/<usuario>/.local/share/zanallaima/oauth.sqlite

# OAuth: clave del operador para la página de consentimiento (32+ caracteres)
ZANA_OAUTH_CONSENT_PASSWORD=

# GitHub (guía: docs/deploy-remote.md, pasos 1 y 2)
# owner/repo separados por coma
ZANA_GITHUB_REPOS=
# Token fine-grained de la cuenta autora
ZANA_DOWNSTREAM_GITHUB_TOKEN=
# Token de la cuenta revisora
ZANA_REVIEWER_TOKEN=
# Obligatorio: login de GitHub de la cuenta revisora. No tiene valor por defecto.
ZANA_REVIEWER_LOGIN=
ZANA_DOWNSTREAM_GITHUB_URL=https://api.githubcopilot.com/mcp/
ZANA_DOWNSTREAM_GITHUB_TOOLSETS=context,repos,pull_requests,git,actions
ZANA_CHECKS_WORKFLOW=zana-checks.yml
ZANA_REQUIRED_CHECKS=
ZANA_TICKET_TTL_MINUTES=120
ZANA_TICKET_CLAIM_TTL_MINUTES=240
ZANA_DISTINCT_REVIEWER_CLIENT=false
ZANA_TOOL_DEADLINE_MS=45000
ZANA_MERGE_ENABLED=true
ZANA_MERGE_METHOD=squash
